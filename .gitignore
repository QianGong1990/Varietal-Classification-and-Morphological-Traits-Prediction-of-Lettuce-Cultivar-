# Whitelist: dataset, pipeline code, split, model code and best models only
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/remove_background.py
!/resize_dataset.py
!/run_augmentation.py
!/preview_augmentation.py

!/training/
/training/__pycache__/

!/dataset/
/dataset/*
!/dataset/RGBImages/
!/dataset/binary_masks/
!/dataset/split/
!/dataset/GroundTruth_All_388_Images.json
!/dataset/GroundTruth_All_388_Images.csv

!/results/
/results/*
!/results/normalization_params.json
!/results/onnx/
!/results/regression/
/results/regression/*
!/results/regression/model_weights/
/results/regression/model_weights/*
!/results/regression/model_weights/InceptionResNetV2_rgb_best.pth
!/results/regression/model_weights/InceptionResNetV2_segmented_best.pth
!/results/regression/model_weights/SimpleCNN_rgb_best.pth
!/results/classification/
/results/classification/*
!/results/classification/model_weights/
/results/classification/model_weights/*
!/results/classification/model_weights/SimpleCNN_segmented_best.pth
/training/submit_*.sh
